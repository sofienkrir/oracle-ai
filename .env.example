# Copier en .env puis ajuster. Aucune valeur secrète n'est requise pour le mode principal.
ORACLE_ENVIRONMENT=dev
ORACLE_LOG_LEVEL=INFO

# Stockage local des métadonnées (SQLite). Par défaut : ./var/oracle.db
# ORACLE_DATA_DIR=./var
# ORACLE_DATABASE_URL=sqlite:///./var/oracle.db

# Limites d'import
ORACLE_MAX_UPLOAD_MB=50
ORACLE_MAX_ROWS=600000
ORACLE_MAX_COLUMNS=200
ORACLE_MAX_XLSX_UNCOMPRESSED_MB=300

# Copies de travail en mémoire
ORACLE_WORKSPACE_MAX_DATASETS=5
ORACLE_WORKSPACE_TTL_MINUTES=120

# Origines autorisées (frontend Vite)
# ORACLE_CORS_ORIGINS=["http://localhost:5173"]

# LLM optionnel (étape ultérieure) : laisser vide pour le mode déterministe.
# Si renseigné, seuls des résultats déjà calculés seront envoyés au fournisseur.
ORACLE_LLM_API_KEY=
